# Server Port
PORT=5000

# Meta Webhook Verification Token (set the exact same string in Meta App Dashboard)
META_VERIFY_TOKEN=leadgen_verify_token_2026

# Meta Page Access Token (optional if using fallback/sandbox mode, required to fetch real lead details from Graph API)
META_PAGE_ACCESS_TOKEN=

# Meta Graph API Version
META_GRAPH_API_VERSION=v21.0
